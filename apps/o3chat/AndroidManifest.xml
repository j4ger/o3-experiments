<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.j4ger.o3chat"
    android:versionCode="2"
    android:versionName="1.1">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="37" />
    <uses-permission android:name="com.xiaomi.aiservice.permission.AI_ABILITY" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="com.xiaomi.aiservice" />
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="me.weishu.kernelsu" />
        <package android:name="com.rifsxd.ksunext" />
        <package android:name="com.sukisu.ultra" />
    </queries>

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:label="Taiyi Chat"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="dev.j4ger.o3chat.shizuku"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>